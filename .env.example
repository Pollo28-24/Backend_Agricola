DATABASE_URL="mysql://root:password@localhost:3306/backend"
# Base de datos sombra opcional para tareas de migración e inspección de drift con Prisma
# SHADOW_DATABASE_URL="mysql://usuario:password@localhost:3306/prisma_shadow"
PORT=3000

# Secretos JWT: mínimo 64 caracteres obligatorios en todos los entornos (generar con crypto.randomBytes(48).toString('base64'))
JWT_SECRET="REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES_BASE64"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="REEMPLAZAR_CON_SECRETO_REFRESH_DE_AL_MENOS_64_CARACTERES_BASE64_"
JWT_REFRESH_EXPIRES_IN="7d"

# Seguridad y Rate Limiting (Hito 11A)
THROTTLE_ENABLED=true
TRUST_PROXY=false

# Almacenamiento desacoplado y descarga firmada (Hito 10A)
STORAGE_LOCAL_PATH="./storage_uploads"
STORAGE_SIGNED_URL_SECRET="clave_secreta_firmada_minimo_32_caracteres_cambiar_en_produccion"
STORAGE_SIGNED_URL_TTL_SECONDS=300
