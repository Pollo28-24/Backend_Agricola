NODE_ENV=development # development | test | production
DATABASE_URL="mysql://root:password@localhost:3306/backend"
# Recuperación de clave pública RSA para MySQL 8.0 caching_sha2_password (solo desarrollo y pruebas; en producción usar TLS y no activarla)
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
# Base de datos sombra opcional para tareas de migración e inspección de drift con Prisma
# SHADOW_DATABASE_URL="mysql://usuario:password@localhost:3306/prisma_shadow"
PORT=3000

# Secretos JWT: mínimo 64 caracteres obligatorios en todos los entornos (generar con crypto.randomBytes(48).toString('base64'))
JWT_SECRET="REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES_BASE64"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="REEMPLAZAR_CON_SECRETO_REFRESH_DE_AL_MENOS_64_CARACTERES_BASE64_"
JWT_REFRESH_EXPIRES_IN="7d"

# Seguridad y Rate Limiting (Hito 11A)
THROTTLE_ENABLED=true
TRUST_PROXY=false

# Almacenamiento desacoplado y descarga firmada (Hito 10A / R2 DT-07)
STORAGE_DRIVER="local" # local | r2
STORAGE_LOCAL_PATH="./storage_uploads"
STORAGE_SIGNED_URL_SECRET="clave_secreta_firmada_minimo_32_caracteres_cambiar_en_produccion"
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Variables Cloudflare R2 (obligatorias solo cuando STORAGE_DRIVER="r2")
R2_ACCOUNT_ID="tu_account_id"
R2_BUCKET_NAME="tu_bucket_privado"
R2_ENDPOINT="https://tu_account_id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="tu_access_key"
R2_SECRET_ACCESS_KEY="tu_secret_access_key"

# Control de versión cliente móvil Flutter (Hito 11D - ADR-015)
MIN_APP_VERSION="1.0.0"
APP_STORE_URL="https://play.google.com/store/apps/details?id=com.rentabilidad.agricola"

# Correo y Recuperación de Contraseña (Hito 11E)
MAIL_TRANSPORT="log" # brevo | log | memory
BREVO_API_KEY=""
MAIL_FROM_EMAIL="no-reply@rentabilidad-agricola.com"
MAIL_FROM_NAME="Rentabilidad Agrícola"
PASSWORD_RESET_URL="http://localhost:3000/restablecer-contrasena"
PASSWORD_RESET_EXPIRES_MINUTES=15
