NODE_ENV=test
PORT=3001
DATABASE_URL="mysql://root:123456@localhost:3306/rentabilidad_agricola_test?connection_limit=25"
JWT_SECRET="e2e_testing_jwt_secret_key_minimum_32_characters_long"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="e2e_testing_jwt_refresh_secret_key_minimum_32_characters_long"
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_DRIVER="local" # local | r2 (variables R2 obligatorias solo con STORAGE_DRIVER="r2")
STORAGE_LOCAL_PATH="./storage_uploads_test"
STORAGE_SIGNED_URL_SECRET="e2e_testing_storage_signed_url_secret_key_32_chars_long"
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Variables Cloudflare R2 (obligatorias solo cuando STORAGE_DRIVER="r2")
R2_ACCOUNT_ID="tu_account_id"
R2_BUCKET_NAME="tu_bucket_privado"
R2_ENDPOINT="https://tu_account_id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="tu_access_key"
R2_SECRET_ACCESS_KEY="tu_secret_access_key"
MAIL_TRANSPORT="memory"
PASSWORD_RESET_URL="http://localhost:3000/restablecer-contrasena"
PASSWORD_RESET_EXPIRES_MINUTES=15
